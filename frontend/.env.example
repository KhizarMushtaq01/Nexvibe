# Vite only exposes VITE_-prefixed variables to client code.
# Client IDs are public identifiers, safe to ship in the frontend bundle.

# Backend origin for API + socket.io traffic. Leave empty for local dev -- the
# dev server proxies /api and /socket.io to localhost:5000 (see vite.config.js).
# Set it on any deployment where the frontend and backend are on different
# origins, e.g. https://nexvibe-api.onrender.com -- and add that frontend origin
# to the backend's ALLOWED_ORIGINS, or CORS will reject it.
VITE_API_URL=

VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id
VITE_FACEBOOK_APP_ID=your_facebook_app_id
VITE_APPLE_CLIENT_ID=your_apple_services_id
