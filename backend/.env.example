# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Comma-separated list of allowed CORS origins. Falls back to CLIENT_URL if unset.
ALLOWED_ORIGINS=http://localhost:5173
# Set to 1 ONLY when deployed behind exactly one trusted reverse proxy / PaaS
# load balancer (so req.ip resolves correctly for geo-restriction and the
# IP-keyed rate limiters). Leave unset/0 for direct-internet-facing
# deployments and local dev -- otherwise any client can spoof their IP via
# the X-Forwarded-For header.
TRUST_PROXY=

# MongoDB
MONGODB_URI=mongodb://localhost:27017/nexvibe

# JWT -- short-lived access token + longer-lived refresh token (rotated on
# every use). Supersedes the old single 7-day JWT_EXPIRE/JWT_COOKIE_EXPIRE
# scheme, which is no longer read anywhere.
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (rate limiting) -- falls back automatically to an in-memory
# (per-instance) rate limit store if Redis is unreachable; see
# config/redis.js and middleware/rateLimiters.js.
REDIS_URL=redis://localhost:6379
# Set true to force TLS on a redis:// URL (a rediss:// URL enables it automatically).
REDIS_TLS=false
# Optional: path to a CA cert file, or the PEM content itself, for a private/self-signed CA.
REDIS_TLS_CA=
# Set false ONLY for local dev against a self-signed cert -- never in production.
REDIS_TLS_REJECT_UNAUTHORIZED=true
REDIS_USERNAME=
REDIS_PASSWORD=

# Email (Resend - https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=NexVibe <onboarding@resend.dev>

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook Login (https://developers.facebook.com/apps)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Sign in with Apple (Services ID, from https://developer.apple.com/account/resources/identifiers)
APPLE_CLIENT_ID=your_apple_services_id

# Twilio (SMS OTP - https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# App
APP_NAME=NexVibe
FRONTEND_URL=http://localhost:5173
